{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="theme-color"
  content="{{ settings.page_background_color }}"
>

{%- comment -%}
  Google Search Console ownership verification.

  The "HTML tag" method rather than the "HTML file" method: Google's file method needs the
  file served from the domain root, and Shopify only serves robots.txt and sitemap.xml
  from there — an uploaded googleXXXX.html would sit on cdn.shopify.com and never verify.

  The code is read from a theme setting so it survives theme updates and needs no code
  change. Google keeps checking after verification, so leave it in place.
{%- endcomment -%}
{%- if settings.seo_google_verification != blank -%}
  <meta
    name="google-site-verification"
    content="{{ settings.seo_google_verification | strip | escape }}"
  >
{%- endif -%}

{%- liquid
  # ---------------------------------------------------------------------------
  # Meta description
  #
  # `page_description` is whatever the merchant typed into the admin's SEO field and
  # always wins. Where it is empty, fall back to the resource's own copy rather than
  # emitting nothing: a description drawn from the page's real content is unique by
  # construction, which is what keeps these off Search Console's duplicate report.
  # Nothing here invents text — every branch reads existing store content.
  # ---------------------------------------------------------------------------
  assign meta_description = page_description

  if meta_description == blank
    case request.page_type
      when 'product'
        assign meta_description = product.description
      when 'collection'
        assign meta_description = collection.description
      when 'article'
        assign meta_description = article.excerpt_or_content
      when 'blog'
        assign meta_description = blog.metafields.descriptors.subtitle.value
      when 'page'
        assign meta_description = page.content
    endcase

    assign meta_description = meta_description | strip_html | strip_newlines | strip

    if meta_description == blank
      assign meta_description = shop.description
    endif

    # 30 words lands inside the ~155 characters Google renders without truncating.
    assign meta_description = meta_description | truncatewords: 30
  endif

  # ---------------------------------------------------------------------------
  # Canonical URL
  #
  # Shopify's `canonical_url` is correct for every ordinary page, so it is used as-is.
  # The exception is a faceted collection or search view: those URLs are near-duplicates
  # of the unfiltered listing and must not compete with it, so the canonical is pointed
  # back at the clean listing URL and the view is marked noindex,follow below.
  # ---------------------------------------------------------------------------
  assign has_active_facets = false

  # Only build the facet list on templates that have one. Iterating a nil collection is
  # not reliably a no-op in Liquid, so the loop is guarded rather than fed an empty value.
  assign facet_source = nil

  if request.page_type == 'collection'
    assign facet_source = collection.filters
  elsif request.page_type == 'search'
    assign facet_source = search.filters
  endif

  if facet_source.size > 0
    for facet in facet_source
      if facet.active_values.size > 0
        assign has_active_facets = true
        break
      endif

      # Price ranges carry their state in min/max rather than in active_values.
      if facet.min_value.value != blank or facet.max_value.value != blank
        assign has_active_facets = true
        break
      endif
    endfor
  endif

  assign has_sort_override = false
  if request.page_type == 'collection' and collection.sort_by != blank
    if collection.sort_by != collection.default_sort_by
      assign has_sort_override = true
    endif
  endif

  assign is_faceted_view = false
  if settings.seo_noindex_faceted
    if has_active_facets or has_sort_override or current_tags
      assign is_faceted_view = true
    endif
  endif

  assign canonical_href = canonical_url

  if is_faceted_view and request.page_type == 'collection'
    assign canonical_href = request.origin | append: collection.url
  elsif is_faceted_view and request.page_type == 'search'
    assign canonical_href = request.origin | append: routes.search_url
  endif

  # ---------------------------------------------------------------------------
  # Robots directives
  #
  # Only views that genuinely should not compete in search are excluded, and each stays
  # crawlable (`follow`) so link equity still flows through to the pages that should
  # rank. Everything not listed here is left indexable on purpose.
  # ---------------------------------------------------------------------------
  assign robots_directive = ''

  if is_faceted_view
    # Faceted and sorted listings are permutations of a page that is already indexed.
    assign robots_directive = 'noindex, follow'
  endif

  case request.page_type
    when 'search'
      # Internal search results are thin and infinitely variable.
      assign robots_directive = 'noindex, follow'
    when 'cart'
      assign robots_directive = 'noindex, follow'
    when 'gift_card'
      # A gift card page is addressed to one recipient and carries a private code.
      assign robots_directive = 'noindex, nofollow'
    when 'password'
      assign robots_directive = 'noindex, nofollow'
    when 'customers/account', 'customers/login', 'customers/register', 'customers/order', 'customers/addresses', 'customers/activate_account', 'customers/reset_password'
      assign robots_directive = 'noindex, nofollow'
  endcase
-%}

{%- if robots_directive != blank -%}
  <meta
    name="robots"
    content="{{ robots_directive }}"
  >
{%- endif -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_href | default: request.origin
  assign og_type = 'website'
  assign og_description = meta_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>
<meta
  property="og:locale"
  content="{{ request.locale.iso_code }}"
>

{%- if page_image -%}
  {%- comment -%}
    Both tags are https. An http: URL here is a mixed-content reference that some
    scrapers drop outright, which costs the share preview its image.
  {%- endcomment -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
  <meta
    property="og:image:alt"
    content="{{ page_image.alt | default: og_title | escape }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.seo_social_x != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.seo_social_x | split: '/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>{{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

<link
  rel="canonical"
  href="{{ canonical_href }}"
>

{%- if meta_description != blank -%}
  <meta
    name="description"
    content="{{ meta_description | escape }}"
  >
{%- endif -%}

{%- comment -%}
  ───────────────────────────────────────────────────────────────────────────────
  INLINED WORKAROUND — not the preferred structure.

  This block is the body of `snippets/structured-data.liquid` and
  `snippets/breadcrumb-trail.liquid`, pasted in. It belongs in those files, and
  both still exist in the repo, unreferenced, ready to go back to.

  Why it is here: the store receives modified theme files but is not receiving
  newly added ones, so `{% render 'structured-data' %}` threw
  "Could not find asset snippets/structured-data.liquid" on every page. The cause
  is in the GitHub-to-Shopify delivery, not in the theme — every local check
  passes and the files are present at origin/master.

  TO RESTORE once delivery is fixed: replace this whole block with
  `{% render 'structured-data' %}` and put back the `{% render 'breadcrumbs' %}`
  calls in the seven main sections (see git history for 30384fa).
  ───────────────────────────────────────────────────────────────────────────────
{%- endcomment -%}

{%- liquid
  assign origin = request.origin
  assign crumbs = ''

  case request.page_type
    when 'index', 'password', 'gift_card'
      assign crumbs = ''

    when 'product'
      comment
        Prefer the collection the visitor actually came through. Falling back to the
        product's first real collection keeps the trail populated on direct hits,
        while skipping the catch-all collections that carry no navigational meaning.
      endcomment
      assign crumb_collection = collection

      if crumb_collection == blank
        for product_collection in product.collections
          unless product_collection.handle == 'all' or product_collection.handle == 'frontpage'
            assign crumb_collection = product_collection
            break
          endunless
        endfor
      endif

      if crumb_collection != blank
        assign crumbs = crumb_collection.title | append: '||' | append: origin | append: crumb_collection.url
        assign crumbs = crumbs | append: '|~|'
      endif

      comment
        The product crumb points at the bare /products/ URL rather than the
        collection-scoped one, so it matches the canonical URL Shopify emits.
      endcomment
      assign crumbs = crumbs | append: product.title | append: '||' | append: origin | append: product.url

    when 'collection'
      assign crumbs = collection.title | append: '||' | append: origin | append: collection.url

    when 'list-collections'
      assign crumbs = 'content.search_results_resource_collections' | t | append: '||' | append: origin | append: routes.collections_url

    when 'blog'
      assign crumbs = blog.title | append: '||' | append: origin | append: blog.url

    when 'article'
      assign crumbs = blog.title | append: '||' | append: origin | append: blog.url
      assign crumbs = crumbs | append: '|~|' | append: article.title | append: '||' | append: origin | append: article.url

    when 'page'
      assign crumbs = page.title | append: '||' | append: origin | append: page.url

    when 'search'
      assign crumbs = 'content.search' | t | append: '||' | append: origin | append: routes.search_url

    when 'cart'
      assign crumbs = 'accessibility.cart' | t | append: '||' | append: origin | append: routes.cart_url

  endcase

  assign breadcrumb_trail = ''
  if crumbs != blank
    assign home_crumb = shop.name | append: '||' | append: origin | append: routes.root_url
    assign breadcrumb_trail = home_crumb | append: '|~|' | append: crumbs
  endif
-%}

{%- liquid
  assign shop_url = shop.url

  # The JewelryStore / Store types descend from LocalBusiness, which is what earns a
  # place in map and "near me" results. Organization is the online-only fallback.
  assign business_type = settings.seo_business_type | default: 'Organization'
  assign is_local_business = false
  if business_type != 'Organization'
    assign is_local_business = true
  endif

  assign org_id = shop_url | append: '/#organization'
  assign logo_id = shop_url | append: '/#logo'
  assign website_id = shop_url | append: '/#website'
  assign webpage_id = canonical_url | append: '#webpage'
  assign breadcrumb_id = canonical_url | append: '#breadcrumb'

  assign org_description = shop.description | default: shop.name

  # Only the profiles the merchant filled in; sameAs must never claim an account the
  # business does not own.
  assign social_profiles = ''
  assign social_candidates = settings.seo_social_facebook | append: ',' | append: settings.seo_social_instagram | append: ',' | append: settings.seo_social_tiktok | append: ',' | append: settings.seo_social_youtube | append: ',' | append: settings.seo_social_pinterest | append: ',' | append: settings.seo_social_x
  assign social_profiles = social_candidates | split: ','

  assign latitude = settings.seo_latitude | default: shop.address.latitude
  assign longitude = settings.seo_longitude | default: shop.address.longitude

  assign opening_hours = settings.seo_opening_hours | strip | newline_to_br | split: '<br />'
  assign service_areas = settings.seo_service_areas | split: ','

  # WebPage subtypes give AI and search systems a coarse signal about what kind of page
  # this is before they read any of the content.
  case request.page_type
    when 'product'
      assign webpage_type = 'ItemPage'
    when 'collection'
      assign webpage_type = 'CollectionPage'
    when 'list-collections'
      assign webpage_type = 'CollectionPage'
    when 'search'
      assign webpage_type = 'SearchResultsPage'
    when 'cart'
      assign webpage_type = 'CheckoutPage'
    else
      assign webpage_type = 'WebPage'
  endcase

  assign webpage_name = page_title | default: shop.name
  assign webpage_description = page_description | default: org_description

  # numberOfItems has to match the number of entries actually emitted below, not the
  # collection total, or the list contradicts itself.
  assign item_list_size = collection.products.size
  if item_list_size > 48
    assign item_list_size = 48
  endif
-%}

{%- assign breadcrumb_items = breadcrumb_trail | strip | split: '|~|' -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": {{ business_type | json }},
        "@id": {{ org_id | json }},
        "name": {{ shop.name | json }},
        "url": {{ shop_url | json }},
        "description": {{ org_description | strip_html | strip | json }}
        {%- if settings.logo != blank %},
          "logo": {
            "@type": "ImageObject",
            "@id": {{ logo_id | json }},
            "url": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
            "contentUrl": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
            "width": {{ settings.logo.width | json }},
            "height": {{ settings.logo.height | json }},
            "caption": {{ shop.name | json }}
          },
          "image": { "@id": {{ logo_id | json }} }
        {%- endif -%}
        {%- if shop.phone != blank %},
          "telephone": {{ shop.phone | json }}
        {%- endif -%}
        {%- if shop.email != blank %},
          "email": {{ shop.email | json }}
        {%- endif -%}
        {%- if shop.address.street != blank or shop.address.city != blank %},
          "address": {
            "@type": "PostalAddress",
            "streetAddress": {{ shop.address.street | json }},
            "addressLocality": {{ shop.address.city | json }},
            "addressRegion": {{ shop.address.province_code | default: shop.address.province | json }},
            "postalCode": {{ shop.address.zip | json }},
            "addressCountry": {{ shop.address.country | default: shop.address.country_upper | json }}
          }
        {%- endif -%}
        {%- if is_local_business -%}
          {%- if latitude != blank and longitude != blank %},
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": {{ latitude | strip | json }},
              "longitude": {{ longitude | strip | json }}
            }
          {%- endif -%}
          {%- if settings.seo_price_range != blank %},
            "priceRange": {{ settings.seo_price_range | strip | json }}
          {%- endif -%}
          {%- if settings.seo_opening_hours != blank %},
            "openingHours": [
              {%- comment -%}
                A separate counter rather than forloop.first: a blank first line would
                otherwise leave a leading comma and break the JSON.
              {%- endcomment -%}
              {%- assign opening_hour_index = 0 -%}
              {%- for opening_hour in opening_hours -%}
                {%- assign opening_hour_value = opening_hour | strip_html | strip -%}
                {%- if opening_hour_value != blank -%}
                  {%- if opening_hour_index > 0 %},{% endif -%}
                  {{ opening_hour_value | json }}
                  {%- assign opening_hour_index = opening_hour_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            ]
          {%- endif -%}
          {%- if settings.seo_service_areas != blank %},
            "areaServed": [
              {%- assign service_area_index = 0 -%}
              {%- for service_area in service_areas -%}
                {%- assign service_area_value = service_area | strip -%}
                {%- if service_area_value != blank -%}
                  {%- if service_area_index > 0 %},{% endif -%}
                  { "@type": "Place", "name": {{ service_area_value | json }} }
                  {%- assign service_area_index = service_area_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            ]
          {%- endif -%}
        {%- endif -%}
        {%- if settings.seo_social_facebook != blank
          or settings.seo_social_instagram != blank
          or settings.seo_social_tiktok != blank
          or settings.seo_social_youtube != blank
          or settings.seo_social_pinterest != blank
          or settings.seo_social_x != blank
        %},
          "sameAs": [
            {%- assign social_index = 0 -%}
            {%- for social_profile in social_profiles -%}
              {%- assign social_url = social_profile | strip -%}
              {%- if social_url != blank -%}
                {%- if social_index > 0 %},{% endif -%}
                {{ social_url | json }}
                {%- assign social_index = social_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        {%- endif -%}
      },
      {
        "@type": "WebSite",
        "@id": {{ website_id | json }},
        "url": {{ shop_url | json }},
        "name": {{ shop.name | json }},
        "description": {{ org_description | strip_html | strip | json }},
        "inLanguage": {{ request.locale.iso_code | json }},
        "publisher": { "@id": {{ org_id | json }} },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": {{ shop_url | append: routes.search_url | append: '?q={search_term_string}' | json }}
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": {{ webpage_type | json }},
        "@id": {{ webpage_id | json }},
        "url": {{ canonical_url | json }},
        "name": {{ webpage_name | strip_html | strip | json }},
        "description": {{ webpage_description | strip_html | strip | json }},
        "inLanguage": {{ request.locale.iso_code | json }},
        "isPartOf": { "@id": {{ website_id | json }} },
        "about": { "@id": {{ org_id | json }} }
        {%- if breadcrumb_items.size > 1 %},
          "breadcrumb": { "@id": {{ breadcrumb_id | json }} }
        {%- endif -%}
        {%- if page_image != blank %},
          "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": {{ page_image | image_url: width: 1200 | prepend: 'https:' | json }}
          }
        {%- endif -%}
        {%- if request.page_type == 'article' -%}
          {%- if article.published_at %},
            "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }}
          {%- endif -%}
          {%- if article.updated_at %},
            "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }}
          {%- endif -%}
        {%- endif -%}
      }
      {%- if breadcrumb_items.size > 1 -%}
        ,{
          "@type": "BreadcrumbList",
          "@id": {{ breadcrumb_id | json }},
          "itemListElement": [
            {%- for breadcrumb_item in breadcrumb_items -%}
              {%- assign breadcrumb_parts = breadcrumb_item | split: '||' -%}
              {%- unless forloop.first %},{% endunless -%}
              {
                "@type": "ListItem",
                "position": {{ forloop.index }},
                "name": {{ breadcrumb_parts[0] | strip | json }},
                "item": {{ breadcrumb_parts[1] | strip | json }}
              }
            {%- endfor -%}
          ]
        }
      {%- endif -%}
      {%- if request.page_type == 'collection' and collection.products.size > 0 -%}
        ,{
          "@type": "ItemList",
          "@id": {{ canonical_url | append: '#itemlist' | json }},
          "name": {{ collection.title | strip_html | strip | json }},
          "numberOfItems": {{ item_list_size }},
          "itemListOrder": "https://schema.org/ItemListOrderAscending",
          "itemListElement": [
            {%- for collection_product in collection.products limit: 48 -%}
              {%- unless forloop.first %},{% endunless -%}
              {
                "@type": "ListItem",
                "position": {{ forloop.index }},
                "name": {{ collection_product.title | strip_html | strip | json }},
                "url": {{ request.origin | append: collection_product.url | json }}
              }
            {%- endfor -%}
          ]
        }
      {%- endif -%}
    ]
  }
</script>

