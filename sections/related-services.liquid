{% comment %}
  Related services — a contextual link block for service and information pages.

  Exists to solve a site-architecture problem: the individual service pages are reachable
  only from whatever sits in the main navigation, so a service page never links to its
  siblings and a crawler arriving on one finds no route onward. That leaves them shallow
  in the site's internal link graph no matter how good the copy is.

  Links come from a merchant-managed navigation menu rather than being hard-coded, which
  means:
    - the URLs are always real ones, maintained in one place in the admin
    - the anchor text is the menu item's own title, so it stays descriptive and varied
      rather than repeating one exact-match phrase
    - adding a service page to the menu links it from every page carrying this section

  The link to the page being viewed is skipped, so the section never self-links.
{% endcomment %}

{{ 'section-related-services.css' | asset_url | stylesheet_tag }}

{% liquid
  assign service_menu = linklists[section.settings.menu]

  # Compare paths rather than full URLs: menu links are stored as relative paths.
  assign current_path = request.path

  assign visible_link_count = 0
  for service_link in service_menu.links
    unless service_link.url == current_path
      assign visible_link_count = visible_link_count | plus: 1
    endunless
  endfor
%}

{%- if visible_link_count > 0 -%}
  <div class="section page-width-normal">
    <nav
      class="related-services spacing-style"
      style="{% render 'spacing-style', settings: section.settings %}"
      aria-labelledby="RelatedServices-{{ section.id }}"
    >
      <h2 class="related-services__heading" id="RelatedServices-{{ section.id }}">
        {{- section.settings.heading -}}
      </h2>

      {%- if section.settings.intro != blank -%}
        <p class="related-services__intro">{{ section.settings.intro }}</p>
      {%- endif -%}

      <ul class="related-services__list" role="list">
        {%- for service_link in service_menu.links -%}
          {%- unless service_link.url == current_path -%}
            <li class="related-services__item">
              <a class="related-services__link" href="{{ service_link.url }}">
                <span class="related-services__link-title">{{ service_link.title }}</span>
                {%- comment -%}
                  When the menu item points at a page, that page's own SEO description is
                  reused as the teaser. It is already written for this purpose, so there
                  is no second copy to keep in sync and nothing invented here.
                {%- endcomment -%}
                {%- if service_link.type == 'page_link' and service_link.object.metafields.global.description_tag != blank -%}
                  <span class="related-services__link-text">
                    {{- service_link.object.metafields.global.description_tag | strip_html | truncatewords: 18 -}}
                  </span>
                {%- endif -%}
              </a>
            </li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    </nav>
  </div>
{%- elsif request.design_mode -%}
  <div class="section page-width-normal">
    <p class="related-services__placeholder">
      Pick a navigation menu in this section's settings to show related service links.
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Related services",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Other services we offer",
      "info": "Introduces the list of links. Keep it descriptive rather than promotional — it becomes a heading in the page outline that search engines read."
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro text",
      "default": "Bring us a repair, a resize or a restoration — every piece is handled in-house.",
      "info": "One short line under the heading. Leave empty to hide it."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu of services to link to",
      "default": "main-menu",
      "info": "Best practice: in Navigation, build a menu called \"Services\" containing one item per service page, then choose it here. Every page with this section will then link to all of them, and the page being viewed is left out automatically."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Related services"
    }
  ]
}
{% endschema %}
