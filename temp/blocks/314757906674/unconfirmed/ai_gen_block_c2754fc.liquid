{% doc %}
  @prompt
    Create a two-column page section layout. The left column displays customizable rich content: a main heading, a subheading, body text paragraphs, and a bulleted list of services with an optional image below. The right column displays Shopify's native built-in contact form (using the standard Shopify contact form that submits to /contact, with fields for Name, Email, Phone, and Message, and a Send button). The two columns should sit side by side on desktop and stack vertically on mobile. All left-column text should be editable via theme settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-contact-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .ai-contact-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-contact-heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-contact-subheading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.4;
    opacity: 0.8;
  }

  .ai-contact-body-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
  }

  .ai-contact-body-{{ ai_gen_id }} p {
    margin: 0 0 16px 0;
  }

  .ai-contact-body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-contact-services-{{ ai_gen_id }} {
    margin: 0;
    padding-left: 20px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.8;
  }

  .ai-contact-services-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-contact-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-top: 8px;
  }

  .ai-contact-form-wrapper-{{ ai_gen_id }} {
    background-color: {{ block.settings.form_background_color }};
    padding: {{ block.settings.form_padding }}px;
    border-radius: {{ block.settings.form_border_radius }}px;
    border: {{ block.settings.form_border_width }}px solid {{ block.settings.form_border_color }};
  }

  .ai-contact-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-contact-form-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.form_text_color }};
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.form_input_border_color }};
    border-radius: {{ block.settings.form_input_border_radius }}px;
    background-color: {{ block.settings.form_input_background }};
    color: {{ block.settings.form_text_color }};
    font-size: 14px;
    font-family: inherit;
  }

  .ai-contact-form-input-{{ ai_gen_id }}:focus,
  .ai-contact-form-textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.form_input_focus_color }};
    outline-offset: 2px;
  }

  .ai-contact-form-textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-contact-form-button-{{ ai_gen_id }} {
    padding: 14px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-contact-form-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-contact-form-success-{{ ai_gen_id }} {
    padding: 16px;
    background-color: #d4edda;
    color: #155724;
    border-radius: {{ block.settings.form_input_border_radius }}px;
    font-size: 14px;
  }

  .ai-contact-form-error-{{ ai_gen_id }} {
    padding: 16px;
    background-color: #f8d7da;
    color: #721c24;
    border-radius: {{ block.settings.form_input_border_radius }}px;
    font-size: 14px;
  }

  @media screen and (max-width: 768px) {
    .ai-contact-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-contact-section-{{ ai_gen_id }} {
      padding: 30px 16px;
    }

    .ai-contact-form-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.form_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div class="ai-contact-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-container-{{ ai_gen_id }}">
    <div class="ai-contact-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-contact-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <h3 class="ai-contact-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</h3>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-contact-body-{{ ai_gen_id }}">
          {{ block.settings.body_text }}
        </div>
      {% endif %}

      {% if block.settings.services_list != blank %}
        <ul class="ai-contact-services-{{ ai_gen_id }}">
          {% assign services = block.settings.services_list | split: '|' %}
          {% for service in services %}
            {% if service != blank %}
              <li>{{ service | strip }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      {% if block.settings.content_image %}
        <img
          src="{{ block.settings.content_image | image_url: width: 800 }}"
          alt="{{ block.settings.content_image.alt | escape }}"
          class="ai-contact-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.content_image.width }}"
          height="{{ block.settings.content_image.height }}"
        >
      {% endif %}
    </div>

    <div class="ai-contact-form-wrapper-{{ ai_gen_id }}">
      {% form 'contact' %}
        <div class="ai-contact-form-{{ ai_gen_id }}">
          {% if form.posted_successfully? %}
            <div class="ai-contact-form-success-{{ ai_gen_id }}">
              {{ block.settings.success_message }}
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="ai-contact-form-error-{{ ai_gen_id }}">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label for="contact-name-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
              Name
            </label>
            <input
              type="text"
              id="contact-name-{{ ai_gen_id }}"
              name="contact[name]"
              class="ai-contact-form-input-{{ ai_gen_id }}"
              autocomplete="name"
              required
            >
          </div>

          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label for="contact-email-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
              Email
            </label>
            <input
              type="email"
              id="contact-email-{{ ai_gen_id }}"
              name="contact[email]"
              class="ai-contact-form-input-{{ ai_gen_id }}"
              autocomplete="email"
              required
            >
          </div>

          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label for="contact-phone-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
              Phone
            </label>
            <input
              type="tel"
              id="contact-phone-{{ ai_gen_id }}"
              name="contact[phone]"
              class="ai-contact-form-input-{{ ai_gen_id }}"
              autocomplete="tel"
            >
          </div>

          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label for="contact-message-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
              Message
            </label>
            <textarea
              id="contact-message-{{ ai_gen_id }}"
              name="contact[body]"
              class="ai-contact-form-textarea-{{ ai_gen_id }}"
              required
            ></textarea>
          </div>

          <button type="submit" class="ai-contact-form-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact section",
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1c1c1c"
    },
    {
      "type": "header",
      "content": "Left column content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We'd love to hear from you"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Have questions about our products or services? Our team is here to help. Fill out the form and we'll get back to you as soon as possible.</p>"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "textarea",
      "id": "services_list",
      "label": "Services list",
      "info": "Separate each service with a | character",
      "default": "Custom jewelry design|Watch repair services|Appraisals and valuations|Gift wrapping available"
    },
    {
      "type": "image_picker",
      "id": "content_image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Form style"
    },
    {
      "type": "color",
      "id": "form_background_color",
      "label": "Background",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "form_text_color",
      "label": "Text",
      "default": "#1c1c1c"
    },
    {
      "type": "range",
      "id": "form_padding",
      "label": "Padding",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "form_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "form_border_color",
      "label": "Border color",
      "default": "#cfcfcf"
    },
    {
      "type": "range",
      "id": "form_border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Form inputs"
    },
    {
      "type": "color",
      "id": "form_input_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "form_input_border_color",
      "label": "Border",
      "default": "#cfcfcf"
    },
    {
      "type": "color",
      "id": "form_input_focus_color",
      "label": "Focus outline",
      "default": "#1c1c1c"
    },
    {
      "type": "range",
      "id": "form_input_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Submit button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Send Message"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Hover background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border",
      "default": "#1c1c1c"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for contacting us! We'll get back to you soon."
    }
  ],
  "presets": [
    {
      "name": "Contact section"
    }
  ]
}
{% endschema %}
