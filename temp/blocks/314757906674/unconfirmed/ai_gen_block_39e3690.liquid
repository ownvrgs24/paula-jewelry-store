{% doc %}
  @prompt
    Create a two-column page template section for a jewelry/watch service business. The left column should display rich content including a heading (e.g. "Stone Setting"), a subheading (e.g. "Custom Ring Designs in San Diego"), descriptive paragraphs, and a bulleted list of specialty services (e.g. Diamond setting, Color stone setting, Princess stone setting, Topaz stone setting), along with an optional image. The right column should display a "Contact Us Today" form with fields for Name, Email, Phone, Message, a simple math security question (1+1=?), and a reCAPTCHA checkbox. The layout should be side-by-side on desktop and stack vertically on mobile. All text content should be customizable via theme settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-service-contact-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-service-contact-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .ai-service-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-service-heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-service-subheading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.4;
  }

  .ai-service-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-service-description-{{ ai_gen_id }} p {
    margin: 0 0 16px 0;
  }

  .ai-service-description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-service-list-{{ ai_gen_id }} {
    margin: 0;
    padding-left: 20px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.8;
  }

  .ai-service-list-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-service-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-service-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-service-image-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-contact-form-{{ ai_gen_id }} {
    background-color: {{ block.settings.form_background_color }};
    padding: 32px;
    border-radius: {{ block.settings.form_border_radius }}px;
    border: {{ block.settings.form_border_width }}px solid {{ block.settings.form_border_color }};
  }

  .ai-contact-form-title-{{ ai_gen_id }} {
    margin: 0 0 24px 0;
    color: {{ block.settings.form_heading_color }};
    font-size: {{ block.settings.form_heading_size }}px;
    text-align: center;
  }

  .ai-contact-form-fields-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-contact-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-contact-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.form_label_color }};
  }

  .ai-contact-input-{{ ai_gen_id }},
  .ai-contact-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.form_input_border_color }};
    border-radius: {{ block.settings.form_input_border_radius }}px;
    background-color: {{ block.settings.form_input_background }};
    color: {{ block.settings.form_input_text_color }};
    font-size: 14px;
    font-family: inherit;
  }

  .ai-contact-input-{{ ai_gen_id }}:focus,
  .ai-contact-textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.form_input_focus_color }};
    outline-offset: 0;
  }

  .ai-contact-textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-contact-security-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-contact-security-question-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.form_label_color }};
    font-weight: 600;
  }

  .ai-contact-security-input-{{ ai_gen_id }} {
    width: 60px;
    padding: 8px 12px;
    border: 1px solid {{ block.settings.form_input_border_color }};
    border-radius: {{ block.settings.form_input_border_radius }}px;
    background-color: {{ block.settings.form_input_background }};
    color: {{ block.settings.form_input_text_color }};
    font-size: 14px;
    text-align: center;
  }

  .ai-contact-recaptcha-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px;
    background-color: {{ block.settings.form_input_background }};
    border: 1px solid {{ block.settings.form_input_border_color }};
    border-radius: {{ block.settings.form_input_border_radius }}px;
  }

  .ai-contact-checkbox-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    cursor: pointer;
  }

  .ai-contact-recaptcha-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.form_label_color }};
    cursor: pointer;
  }

  .ai-contact-submit-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-contact-submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-contact-success-{{ ai_gen_id }} {
    padding: 12px 16px;
    background-color: {{ block.settings.success_background }};
    color: {{ block.settings.success_text_color }};
    border-radius: {{ block.settings.form_input_border_radius }}px;
    text-align: center;
    font-size: 14px;
  }

  .ai-contact-error-{{ ai_gen_id }} {
    padding: 12px 16px;
    background-color: {{ block.settings.error_background }};
    color: {{ block.settings.error_text_color }};
    border-radius: {{ block.settings.form_input_border_radius }}px;
    font-size: 14px;
  }

  @media screen and (max-width: 768px) {
    .ai-service-contact-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-contact-form-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-service-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-service-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }
  }
{% endstyle %}

<service-contact-{{ ai_gen_id }} class="ai-service-contact-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-service-contact-container-{{ ai_gen_id }}">
    <div class="ai-service-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-service-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <h3 class="ai-service-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</h3>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-service-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      {% if block.settings.services_list != blank %}
        <ul class="ai-service-list-{{ ai_gen_id }}">
          {% assign services = block.settings.services_list | split: ',' %}
          {% for service in services %}
            <li>{{ service | strip }}</li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if block.settings.image != blank %}
        <div class="ai-service-image-wrapper-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-service-image-{{ ai_gen_id }}"
          >
        </div>
      {% endif %}
    </div>

    <div class="ai-contact-form-{{ ai_gen_id }}">
      {% form 'contact' %}
        <input type="hidden" name="contact[service]" value="{{ block.settings.heading }}">
        
        <h3 class="ai-contact-form-title-{{ ai_gen_id }}">{{ block.settings.form_title }}</h3>

        {% if form.posted_successfully? %}
          <div class="ai-contact-success-{{ ai_gen_id }}" id="ai-contact-success-{{ ai_gen_id }}">
            {{ block.settings.success_message }}
          </div>
        {% else %}
          <div class="ai-contact-form-fields-{{ ai_gen_id }}">
            {% if form.errors %}
              <div class="ai-contact-error-{{ ai_gen_id }}" id="ai-contact-error-{{ ai_gen_id }}">
                {% for field in form.errors %}
                  <div>{{ field | capitalize }}: {{ form.errors.messages[field] }}</div>
                {% endfor %}
              </div>
            {% endif %}

            <div class="ai-contact-field-{{ ai_gen_id }}">
              <label for="contact-name-{{ ai_gen_id }}" class="ai-contact-label-{{ ai_gen_id }}">
                Name <span style="color: #d82c0d;">*</span>
              </label>
              <input
                type="text"
                id="contact-name-{{ ai_gen_id }}"
                name="contact[name]"
                class="ai-contact-input-{{ ai_gen_id }}"
                value="{{ form.name }}"
                required
                {% if form.errors contains 'name' %}
                  aria-invalid="true"
                  aria-describedby="ai-contact-error-{{ ai_gen_id }}"
                {% endif %}
              >
            </div>

            <div class="ai-contact-field-{{ ai_gen_id }}">
              <label for="contact-email-{{ ai_gen_id }}" class="ai-contact-label-{{ ai_gen_id }}">
                Email <span style="color: #d82c0d;">*</span>
              </label>
              <input
                type="email"
                id="contact-email-{{ ai_gen_id }}"
                name="contact[email]"
                class="ai-contact-input-{{ ai_gen_id }}"
                value="{{ form.email }}"
                autocomplete="email"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ai-contact-error-{{ ai_gen_id }}"
                {% endif %}
              >
            </div>

            <div class="ai-contact-field-{{ ai_gen_id }}">
              <label for="contact-phone-{{ ai_gen_id }}" class="ai-contact-label-{{ ai_gen_id }}">
                Phone
              </label>
              <input
                type="tel"
                id="contact-phone-{{ ai_gen_id }}"
                name="contact[phone]"
                class="ai-contact-input-{{ ai_gen_id }}"
                value="{{ form.phone }}"
                autocomplete="tel"
              >
            </div>

            <div class="ai-contact-field-{{ ai_gen_id }}">
              <label for="contact-message-{{ ai_gen_id }}" class="ai-contact-label-{{ ai_gen_id }}">
                Message <span style="color: #d82c0d;">*</span>
              </label>
              <textarea
                id="contact-message-{{ ai_gen_id }}"
                name="contact[body]"
                class="ai-contact-textarea-{{ ai_gen_id }}"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="ai-contact-error-{{ ai_gen_id }}"
                {% endif %}
              >{{ form.body }}</textarea>
            </div>

            <div class="ai-contact-field-{{ ai_gen_id }}">
              <div class="ai-contact-security-{{ ai_gen_id }}">
                <span class="ai-contact-security-question-{{ ai_gen_id }}">{{ block.settings.security_question }}</span>
                <input
                  type="text"
                  id="contact-security-{{ ai_gen_id }}"
                  name="contact[security_answer]"
                  class="ai-contact-security-input-{{ ai_gen_id }}"
                  required
                  aria-label="Security question answer"
                >
              </div>
            </div>

            <div class="ai-contact-field-{{ ai_gen_id }}">
              <div class="ai-contact-recaptcha-{{ ai_gen_id }}">
                <input
                  type="checkbox"
                  id="contact-recaptcha-{{ ai_gen_id }}"
                  name="contact[recaptcha]"
                  class="ai-contact-checkbox-{{ ai_gen_id }}"
                  required
                >
                <label for="contact-recaptcha-{{ ai_gen_id }}" class="ai-contact-recaptcha-label-{{ ai_gen_id }}">
                  I'm not a robot
                </label>
              </div>
            </div>

            <button type="submit" class="ai-contact-submit-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</service-contact-{{ ai_gen_id }}>

<script>
  (function() {
    class ServiceContact{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const form = this.querySelector('form');
        if (form) {
          form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const securityInput = this.querySelector('#contact-security-{{ ai_gen_id }}');
        const recaptchaCheckbox = this.querySelector('#contact-recaptcha-{{ ai_gen_id }}');
        
        if (securityInput && securityInput.value !== '2') {
          event.preventDefault();
          alert('Please answer the security question correctly.');
          securityInput.focus();
          return false;
        }

        if (recaptchaCheckbox && !recaptchaCheckbox.checked) {
          event.preventDefault();
          alert('Please confirm you are not a robot.');
          return false;
        }
      }
    }

    customElements.define('service-contact-{{ ai_gen_id }}', ServiceContact{{ ai_gen_id }});
  })();
</script>

