{% doc %}
  @prompt
    Create a full-width mega menu navigation that appears on hover. When hovering over a top-level nav item (like "WOMEN" or "MEN"), a full-width dropdown panel should appear below the header. The panel should have a multi-column layout with category links on the left (e.g., Bags, Shoulder bags, Mini bags), popular models in the middle, and featured images with captions on the right. The menu should have a clean, minimal luxury fashion aesthetic with small uppercase labels, simple text links, and editorial-style product images. The dropdown should smoothly appear on hover and close when the mouse leaves.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-mega-menu-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
  }

  .ai-mega-menu__nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.nav_alignment }};
    align-items: center;
    gap: {{ block.settings.nav_item_spacing }}px;
    padding: {{ block.settings.nav_padding_vertical }}px {{ block.settings.nav_padding_horizontal }}px;
    background-color: {{ block.settings.nav_background_color }};
    border-bottom: {{ block.settings.nav_border_width }}px solid {{ block.settings.nav_border_color }};
  }

  .ai-mega-menu__item-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-mega-menu__link-{{ ai_gen_id }} {
    display: block;
    padding: {{ block.settings.link_padding_vertical }}px {{ block.settings.link_padding_horizontal }}px;
    color: {{ block.settings.nav_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.nav_font_size }}px;
    font-weight: {{ block.settings.nav_font_weight }};
    letter-spacing: {{ block.settings.nav_letter_spacing }}px;
    text-transform: {{ block.settings.nav_text_transform }};
    transition: color 0.3s ease;
    cursor: pointer;
  }

  .ai-mega-menu__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.nav_text_hover_color }};
  }

  .ai-mega-menu__dropdown-{{ ai_gen_id }} {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100vw;
    background-color: {{ block.settings.dropdown_background_color }};
    border-top: {{ block.settings.dropdown_border_width }}px solid {{ block.settings.dropdown_border_color }};
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
    z-index: 1000;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .ai-mega-menu__item-{{ ai_gen_id }}:hover .ai-mega-menu__dropdown-{{ ai_gen_id }} {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .ai-mega-menu__dropdown-content-{{ ai_gen_id }} {
    max-width: {{ block.settings.dropdown_max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.dropdown_padding }}px;
    display: grid;
    grid-template-columns: {{ block.settings.column_layout }};
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-mega-menu__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.link_spacing }}px;
  }

  .ai-mega-menu__column-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_font_size }}px;
    font-weight: {{ block.settings.category_font_weight }};
    letter-spacing: {{ block.settings.category_letter_spacing }}px;
    text-transform: {{ block.settings.category_text_transform }};
    color: {{ block.settings.category_text_color }};
    margin-bottom: {{ block.settings.category_margin_bottom }}px;
  }

  .ai-mega-menu__column-link-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_font_size }}px;
    color: {{ block.settings.link_text_color }};
    text-decoration: none;
    transition: color 0.3s ease;
    line-height: 1.6;
  }

  .ai-mega-menu__column-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_text_hover_color }};
  }

  .ai-mega-menu__featured-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.featured_spacing }}px;
  }

  .ai-mega-menu__featured-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-mega-menu__featured-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }

  .ai-mega-menu__featured-item-{{ ai_gen_id }}:hover .ai-mega-menu__featured-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-mega-menu__featured-caption-{{ ai_gen_id }} {
    margin-top: {{ block.settings.caption_margin_top }}px;
    font-size: {{ block.settings.caption_font_size }}px;
    color: {{ block.settings.caption_text_color }};
    text-align: {{ block.settings.caption_alignment }};
  }

  .ai-mega-menu__featured-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-mega-menu__featured-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-mega-menu__dropdown-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-mega-menu__nav-{{ ai_gen_id }} {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }
{% endstyle %}

<mega-menu-{{ ai_gen_id }} class="ai-mega-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <nav class="ai-mega-menu__nav-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign menu_enabled_key = 'menu_' | append: i | append: '_enabled'
        assign menu_label_key = 'menu_' | append: i | append: '_label'
        assign menu_enabled = block.settings[menu_enabled_key]
        assign menu_label = block.settings[menu_label_key]
      %}

      {% if menu_enabled and menu_label != blank %}
        <div class="ai-mega-menu__item-{{ ai_gen_id }}" data-menu-item="{{ i }}">
          <span class="ai-mega-menu__link-{{ ai_gen_id }}">{{ menu_label }}</span>

          <div class="ai-mega-menu__dropdown-{{ ai_gen_id }}">
            <div class="ai-mega-menu__dropdown-content-{{ ai_gen_id }}">
              {% for col in (1..3) %}
                {% liquid
                  assign col_title_key = 'menu_' | append: i | append: '_col' | append: col | append: '_title'
                  assign col_title = block.settings[col_title_key]
                %}

                <div class="ai-mega-menu__column-{{ ai_gen_id }}">
                  {% if col_title != blank %}
                    <h3 class="ai-mega-menu__column-title-{{ ai_gen_id }}">{{ col_title }}</h3>
                  {% endif %}

                  {% if col == 3 %}
                    <div class="ai-mega-menu__featured-{{ ai_gen_id }}">
                      {% for img in (1..2) %}
                        {% liquid
                          assign image_key = 'menu_' | append: i | append: '_featured_image_' | append: img
                          assign caption_key = 'menu_' | append: i | append: '_featured_caption_' | append: img
                          assign link_key = 'menu_' | append: i | append: '_featured_link_' | append: img
                          assign featured_image = block.settings[image_key]
                          assign featured_caption = block.settings[caption_key]
                          assign featured_link = block.settings[link_key]
                        %}

                        {% if featured_image != blank or featured_caption != blank %}
                          <a href="{{ featured_link }}" class="ai-mega-menu__featured-item-{{ ai_gen_id }}">
                            {% if featured_image != blank %}
                              <img
                                src="{{ featured_image | image_url: width: 600 }}"
                                alt="{{ featured_image.alt | escape }}"
                                class="ai-mega-menu__featured-image-{{ ai_gen_id }}"
                                loading="lazy"
                                width="{{ featured_image.width }}"
                                height="{{ featured_image.height }}"
                              >
                            {% else %}
                              <div class="ai-mega-menu__featured-placeholder-{{ ai_gen_id }}">
                                {{ 'image' | placeholder_svg_tag }}
                              </div>
                            {% endif %}
                            {% if featured_caption != blank %}
                              <div class="ai-mega-menu__featured-caption-{{ ai_gen_id }}">{{ featured_caption }}</div>
                            {% endif %}
                          </a>
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% else %}
                    {% for link in (1..8) %}
                      {% liquid
                        assign link_text_key = 'menu_' | append: i | append: '_col' | append: col | append: '_link' | append: link | append: '_text'
                        assign link_url_key = 'menu_' | append: i | append: '_col' | append: col | append: '_link' | append: link | append: '_url'
                        assign link_text = block.settings[link_text_key]
                        assign link_url = block.settings[link_url_key]
                      %}

                      {% if link_text != blank %}
                        <a href="{{ link_url }}" class="ai-mega-menu__column-link-{{ ai_gen_id }}">{{ link_text }}</a>
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </nav>
</mega-menu-{{ ai_gen_id }}>

<script>
  (function() {
    class MegaMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.menuItems = this.querySelectorAll('.ai-mega-menu__item-{{ ai_gen_id }}');
        this.dropdowns = this.querySelectorAll('.ai-mega-menu__dropdown-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.menuItems.forEach((item) => {
          const dropdown = item.querySelector('.ai-mega-menu__dropdown-{{ ai_gen_id }}');
          
          item.addEventListener('mouseenter', () => {
            this.closeAllDropdowns();
            if (dropdown) {
              dropdown.style.opacity = '1';
              dropdown.style.visibility = 'visible';
              dropdown.style.transform = 'translateY(0)';
            }
          });

          item.addEventListener('mouseleave', () => {
            if (dropdown) {
              dropdown.style.opacity = '0';
              dropdown.style.visibility = 'hidden';
              dropdown.style.transform = 'translateY(-10px)';
            }
          });
        });
      }

      closeAllDropdowns() {
        this.dropdowns.forEach((dropdown) => {
          dropdown.style.opacity = '0';
          dropdown.style.visibility = 'hidden';
          dropdown.style.transform = 'translateY(-10px)';
        });
      }
    }

    customElements.define('mega-menu-{{ ai_gen_id }}', MegaMenu{{ ai_gen_id }});
  })();
</script>

