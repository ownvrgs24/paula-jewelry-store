          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .jewelry-services-section {\n    padding: 80px 20px;\n    background-color: transparent; /* Removed background */\n    color: #2b2b2b;\n    font-family: inherit;\n  }\n  .jewelry-services-container {\n    max-width: 1140px;\n    margin: 0 auto;\n  }\n  \n  /* Header */\n  .jewelry-header {\n    text-align: center;\n    max-width: 720px;\n    margin: 0 auto 60px;\n  }\n  .jewelry-subtitle {\n    text-transform: uppercase;\n    letter-spacing: 2.5px;\n    font-size: 0.8rem;\n    font-weight: 600;\n    color: #967d4e;\n    display: block;\n    margin-bottom: 12px;\n  }\n  .jewelry-title {\n    font-size: 2.3rem;\n    font-weight: 400;\n    letter-spacing: -0.5px;\n    line-height: 1.3;\n    color: #1a1a1a;\n    margin: 0 0 16px;\n  }\n  .jewelry-divider {\n    width: 40px;\n    height: 1px;\n    background-color: #967d4e;\n    margin: 16px auto 20px;\n  }\n  .jewelry-intro {\n    font-size: 1.05rem;\n    line-height: 1.7;\n    color: #555;\n    margin: 0;\n  }\n  \n  /* Services Main */\n  .services-heading-wrap {\n    text-align: center;\n    margin-bottom: 50px;\n  }\n  .services-main-title {\n    font-size: 1.8rem;\n    font-weight: 400;\n    margin-bottom: 10px;\n    color: #1a1a1a;\n  }\n  .services-main-desc {\n    font-size: 1rem;\n    color: #777;\n    margin: 0;\n  }\n  \n  /* 4x2 Clean Grid Layout */\n  .services-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 40px 30px;\n    margin-bottom: 80px;\n  }\n  .service-item {\n    background: transparent; /* Removed card background */\n    border: none; /* Removed border */\n    text-align: center;\n    transition: transform 0.3s ease;\n  }\n  .service-item:hover {\n    transform: translateY(-5px); /* Simple elegant lift on hover */\n  }\n  .service-icon {\n    width: 50px;\n    height: 50px;\n    margin: 0 auto 20px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #967d4e;\n  }\n  .service-icon svg {\n    width: 32px;\n    height: 32px;\n    stroke-width: 1.2; /* Slightly thinner for an elegant look */\n  }\n  .service-item h4 {\n    font-size: 1.05rem;\n    font-weight: 600;\n    margin: 0 0 12px;\n    color: #1a1a1a;\n    letter-spacing: 0.3px;\n  }\n  .service-item p {\n    font-size: 0.9rem;\n    line-height: 1.6;\n    color: #666;\n    margin: 0;\n  }\n  \n  /* Footer Section */\n  .jewelry-footer-box {\n    background-color: transparent; /* Removed background */\n    border-top: 1px solid #eaeaea; /* Changed to a simple top divider */\n    padding: 60px 0 0;\n    text-align: center;\n    max-width: 800px;\n    margin: 0 auto;\n  }\n  .jewelry-footer-box h3 {\n    font-size: 1.5rem;\n    font-weight: 400;\n    margin-bottom: 16px;\n    color: #1a1a1a;\n  }\n  .jewelry-footer-box p {\n    font-size: 1rem;\n    line-height: 1.7;\n    color: #666;\n    margin: 0 auto 30px;\n    max-width: 650px;\n  }\n  .jewelry-btn {\n    display: inline-block;\n    background-color: #1a1a1a;\n    color: #ffffff;\n    padding: 15px 35px;\n    font-size: 0.85rem;\n    font-weight: 500;\n    letter-spacing: 1.2px;\n    text-transform: uppercase;\n    text-decoration: none;\n    border-radius: 3px;\n    transition: background-color 0.3s ease;\n  }\n  .jewelry-btn:hover {\n    background-color: #967d4e;\n    color: #ffffff;\n  }\n  \n  /* Responsive Breakpoints */\n  @media (max-width: 990px) {\n    .services-grid {\n      grid-template-columns: repeat(2, 1fr);\n      gap: 50px 30px;\n    }\n  }\n  @media (max-width: 576px) {\n    .services-grid {\n      grid-template-columns: 1fr;\n      gap: 40px 20px;\n    }\n    .jewelry-title {\n      font-size: 1.8rem;\n    }\n  }\n</style>\n\n<section class=\"jewelry-services-section\">\n  <div class=\"jewelry-services-container\">\n    \n    <!-- Hero Header -->\n    <header class=\"jewelry-header\">\n      <span class=\"jewelry-subtitle\">Care & Craftsmanship</span>\n      <h2 class=\"jewelry-title\">Jewelry Made to Last.<br>Care You Can Trust.</h2>\n      <div class=\"jewelry-divider\"></div>\n      <p class=\"jewelry-intro\">\n        Jewelry is more than something you wear. It marks milestones, carries precious memories, and defines your everyday style. That’s why our skilled artisans are dedicated to keeping your most treasured pieces looking radiant and wearing beautifully for years to come.\n      </p>\n    </header>\n\n    <!-- Services Grid -->\n    <div class=\"services-wrapper\">\n      <div class=\"services-heading-wrap\">\n        <h3 class=\"services-main-title\">What We Offer</h3>\n        <p class=\"services-main-desc\">Expert services tailored to preserve and restore your fine jewelry & timepieces.</p>\n      </div>\n\n      <div class=\"services-grid\">\n        \n        <!-- 1. Jewelry Repairs -->\n        <div class=\"service-item\">\n          <div class=\"service-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"></path>\n            </svg>\n          </div>\n          <h4>Jewelry Repairs</h4>\n          <p>Expert restoration for broken chains, clasps, prongs, and structural wear.</p>\n        </div>\n\n        <!-- 2. Ring Sizing -->\n        <div class=\"service-item\">\n          <div class=\"service-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <circle cx=\"12\" cy=\"12\" r=\"8\"></circle>\n              <path d=\"M12 2v2\"></path>\n              <path d=\"M12 20v2\"></path>\n              <path d=\"m4.93 4.93 1.41 1.41\"></path>\n              <path d=\"m17.66 17.66 1.41 1.41\"></path>\n            </svg>\n          </div>\n          <h4>Ring Sizing & Adjustments</h4>\n          <p>Seamless sizing up or down to ensure a comfortable and secure fit.</p>\n        </div>\n\n        <!-- 3. Cleaning & Polishing -->\n        <div class=\"service-item\">\n          <div class=\"service-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3z\"></path>\n            </svg>\n          </div>\n          <h4>Cleaning & Polishing</h4>\n          <p>Deep ultrasonic cleaning and buffing to restore original brilliance.</p>\n        </div>\n\n        <!-- 4. Stone Setting -->\n        <div class=\"service-item\">\n          <div class=\"service-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <polygon points=\"6 3 18 3 22 9 12 22 2 9\"></polygon>\n              <path d=\"M12 22 8 9h8z\"></path>\n              <path d=\"M2 9h20\"></path>\n            </svg>\n          </div>\n          <h4>Stone Setting & Replacement</h4>\n          <p>Securing loose stones and sourcing matching replacements.</p>\n        </div>\n\n        <!-- 5. Engraving -->\n        <div class=\"service-item\">\n          <div class=\"service-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M12 19l7-7 3 3-7 7-3-3z\"></path>\n              <path d=\"M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z\"></path>\n              <path d=\"M2 2l7.586 7.586\"></path>\n              <circle cx=\"11\" cy=\"11\" r=\"2\"></circle>\n            </svg>\n          </div>\n          <h4>Engraving & Personalization</h4>\n          <p>Custom inscriptions, dates, and monograms for a personal touch.</p>\n        </div>\n\n        <!-- 6. Custom Jewelry -->\n        <div class=\"service-item\">\n          <div class=\"service-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <circle cx=\"6\" cy=\"6\" r=\"3\"></circle>\n              <circle cx=\"18\" cy=\"18\" r=\"3\"></circle>\n              <path d=\"m8.5 8.5 7 7\"></path>\n            </svg>\n          </div>\n          <h4>Custom Jewelry Design</h4>\n          <p>Bring your ideas to life or redesign heirloom pieces into modern designs.</p>\n        </div>\n\n        <!-- 7. Watch Repair -->\n        <div class=\"service-item\">\n          <div class=\"service-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <circle cx=\"12\" cy=\"12\" r=\"7\"></circle>\n              <polyline points=\"12 9 12 12 13.5 13.5\"></polyline>\n              <path d=\"M16.51 17.35l-.35 3.83A2 2 0 0 1 14.17 23H9.83a2 2 0 0 1-1.99-1.82l-.35-3.83\"></path>\n              <path d=\"M7.49 6.65l.35-3.83A2 2 0 0 1 9.83 1h4.34a2 2 0 0 1 1.99 1.82l.35 3.83\"></path>\n            </svg>\n          </div>\n          <h4>Watch Repair & Maintenance</h4>\n          <p>Battery replacements, link removals, crystal care, and servicing.</p>\n        </div>\n\n        <!-- 8. Eyewear Repair -->\n        <div class=\"service-item\">\n          <div class=\"service-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <circle cx=\"6\" cy=\"14\" r=\"4\"></circle>\n              <circle cx=\"18\" cy=\"14\" r=\"4\"></circle>\n              <path d=\"M10 14h4\"></path>\n              <path d=\"m2 14 3.5-7h13L22 14\"></path>\n            </svg>\n          </div>\n          <h4>Eyewear Repair</h4>\n          <p>Precision frame adjustments, hinge repairs, and screw replacements.</p>\n        </div>\n\n      </div>\n    </div>\n\n    <!-- Quality Commitment & CTA -->\n    <div class=\"jewelry-footer-box\">\n      <h3>Quality in Every Detail</h3>\n      <p>\n        We take pride in careful workmanship, quality materials, and meticulous attention to detail. Whether you are purchasing a new piece or bringing in something you have treasured for years, we treat every item with the utmost care.\n      </p>\n      <div class=\"jewelry-cta-wrap\">\n        <!-- Change the href=\"/pages/contact\" to wherever you want the button to link -->\n        <a href=\"/pages/contact\" class=\"jewelry-btn\">\n          Have a Piece That Needs Attention? Contact Us\n        </a>\n      </div>\n    </div>\n\n  </div>\n</section>"
