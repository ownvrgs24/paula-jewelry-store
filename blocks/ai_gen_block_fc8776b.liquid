{% doc %}
  @prompt
    Update the image block to dynamically pull an image from a page metafield (custom.service_hero_image), with a fallback to the static image setting if no metafield image is set.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign dynamic_image = page.metafields.custom.service_hero_image
  if dynamic_image != blank
    assign final_image = dynamic_image
  else
    assign final_image = block.settings.image
  endif
%}

{% style %}
  .ai-dynamic-image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-dynamic-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-dynamic-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: {{ block.settings.image_fit }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-dynamic-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-dynamic-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-dynamic-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-dynamic-image-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-dynamic-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dynamic-image-wrapper-{{ ai_gen_id }}">
    {% if final_image %}
      {%- comment -%}
        The single `src` at width 2000 shipped the same 2000px file to a phone as to a
        desktop. `widths` plus `sizes` lets the browser pick from the CDN's resized
        variants, and `desktop_width_percent` is fed into `sizes` so the estimate matches
        how wide the image actually renders.

        Loading priority is a merchant choice rather than a hard-coded `lazy`: when this
        block is the first thing on the page it is usually the Largest Contentful Paint
        element, and deferring it delays the metric directly.
      {%- endcomment -%}
      {%- liquid
        assign image_widths = '400, 600, 800, 1000, 1200, 1600, 2000'

        assign desktop_vw = block.settings.desktop_width_percent | default: 100
        assign image_sizes = '(min-width: 750px) ' | append: desktop_vw | append: 'vw, 100vw'

        if block.settings.is_above_the_fold
          assign image_loading = 'eager'
          assign image_fetchpriority = 'high'
        else
          assign image_loading = 'lazy'
          assign image_fetchpriority = 'auto'
        endif
      -%}
      {{
        final_image
        | image_url: width: 2000
        | image_tag:
          widths: image_widths,
          sizes: image_sizes,
          width: final_image.width,
          height: final_image.height,
          alt: final_image.alt,
          loading: image_loading,
          fetchpriority: image_fetchpriority
      }}
    {% else %}
      <div class="ai-dynamic-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-dynamic-image-empty-state-{{ ai_gen_id }}">
          Add an image or connect a page metafield (custom.service_hero_image)
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Dynamic image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image source"
    },
    {
      "type": "paragraph",
      "content": "This block will display the page metafield 'custom.service_hero_image' if set, otherwise it will use the static image below."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image"
    },
    {
      "type": "checkbox",
      "id": "is_above_the_fold",
      "label": "This image is visible without scrolling",
      "info": "Turn this on when the image sits at the very top of the page. It then loads at high priority instead of being deferred, which is what Google measures as Largest Contentful Paint. Leave it off for images further down, so they do not compete with the top of the page.",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Dynamic image"
    }
  ]
}
{% endschema %}
