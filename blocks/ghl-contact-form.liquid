{% liquid
  assign form_url = block.settings.form_url | strip
%}

<div
  class="ghl-contact-form spacing-style size-style"
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
    {% if block.settings.background_color != blank %}background-color: {{ block.settings.background_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {%- if form_url != blank -%}
    {% render 'ghl-form-embed',
      form_url: form_url,
      form_name: block.settings.form_name,
      loading_text: block.settings.loading_text,
      min_height: block.settings.min_height
    %}
  {%- elsif request.design_mode -%}
    {{ 'ghl-form-embed.css' | asset_url | stylesheet_tag }}
    <p class="ghl-form__placeholder">
      Add your GoHighLevel form URL in this block's settings to display the form.
    </p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "GoHighLevel form",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "form_url",
      "label": "Form URL",
      "default": "https://api.leadconnectorhq.com/widget/form/mw4q46EMht3eEFMHBVR5",
      "info": "In GoHighLevel, open Sites > Forms > Integrate and copy the address inside src=\"...\" from the embed code."
    },
    {
      "type": "text",
      "id": "form_name",
      "label": "Form name",
      "default": "1. Contact Form",
      "info": "Used by screen readers and by GoHighLevel reporting. Match it to the form's name in GoHighLevel. It is not shown on the page."
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading message",
      "default": "Loading the contact form",
      "info": "Announced by screen readers while the form loads. Sighted visitors see a placeholder instead."
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Starting height",
      "min": 300,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 940,
      "info": "The height before the form loads. GoHighLevel resizes the form to fit its own content once it appears, so this only prevents the page from jumping."
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default",
      "info": "Sits behind the form. Match it to the background you chose inside the GoHighLevel form builder."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "GoHighLevel form",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
