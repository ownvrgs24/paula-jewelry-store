{% comment %}
  Condensed countdown for the announcement bar: message, optional link, flip timer.
  Values are computed here so the correct time is on screen at first paint;
  countdown-timer.js only keeps them ticking.
{% endcomment %}

{%- liquid
  assign s = block.settings
  assign end_date = s.end_date | strip
  assign end_time = s.end_time | strip
  if end_time == blank
    assign end_time = '00:00'
  endif

  # Interpret the merchant's date in the SHOP's timezone, not the visitor's.
  # ponytail: uses today's UTC offset, so a target on the far side of a DST change is
  # off by an hour. Enter the date as a full ISO string if that ever matters.
  assign tz = 'now' | date: '%z'
  assign tz_hh = tz | slice: 0, 3
  assign tz_mm = tz | slice: 3, 2
  assign offset = tz_hh | append: ':' | append: tz_mm

  assign expires_at = end_date | append: 'T' | append: end_time | append: ':00' | append: offset
  assign target = expires_at | date: '%s' | plus: 0
  assign now_seconds = 'now' | date: '%s' | plus: 0
  assign remaining = target | minus: now_seconds
  if remaining < 0
    assign remaining = 0
  endif

  assign days = remaining | divided_by: 86400
  assign hours = remaining | divided_by: 3600 | modulo: 24
  assign minutes = remaining | divided_by: 60 | modulo: 60
  assign seconds = remaining | modulo: 60

  # Days grows past two digits rather than pinning at 99, which would show a wrong
  # number for every day of a sale longer than that. The digit slots follow the value.
  if days > 99
    assign dd = days | append: ''
  else
    assign dd = days | prepend: '0' | slice: -2, 2
  endif
  assign hh = hours | prepend: '0' | slice: -2, 2
  assign mm = minutes | prepend: '0' | slice: -2, 2
  assign ss = seconds | prepend: '0' | slice: -2, 2

  assign unit_keys = 'days,hours,minutes,seconds' | split: ','
  assign unit_values = dd | append: ',' | append: hh | append: ',' | append: mm | append: ',' | append: ss | split: ','
  assign unit_labels = s.unit_labels | default: 'Days,Hrs,Min,Sec' | split: ','

  assign human_date = expires_at | date: '%B %-d, %Y at %-l:%M %p'
  assign has_timer = false
  if end_date != blank and target > 0
    assign has_timer = true
  endif

  # Matches _announcement: when the bar holds more than one block it rotates them, and
  # every slide but the first starts hidden.
  assign block_index = section.blocks | find_index: 'id', block.id
-%}

{%- if has_timer -%}
  <script src="{{ 'countdown-timer.js' | asset_url }}" type="module" fetchpriority="low"></script>
{%- endif -%}

<slideshow-slide
  ref="slides[]"
  class="announcement-bar__slide countdown countdown--{{ block.id }}"
  data-countdown-root
  style="
    --countdown-font: {{ s.font }};
    --countdown-size: {{ s.font_size }};
    {% if s.text_color != blank %}--color: {{ s.text_color }};{% endif %}
    {% if s.timer_color != blank %}--countdown-timer-color: {{ s.timer_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
  aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
>
  <div class="countdown__inner">
    <div class="countdown__text">
      {%- if s.text != blank -%}
        <p class="countdown__message">{{ s.text }}</p>
      {%- endif -%}
      {%- if s.link != blank and s.link_label != blank -%}
        <a class="countdown__link" href="{{ s.link }}">{{ s.link_label }}</a>
      {%- endif -%}
    </div>

    {%- if has_timer -%}
      <countdown-timer
        class="countdown__timer"
        role="timer"
        aria-label="This offer expires on {{ human_date }}"
        expires-at="{{ expires_at }}"
        expiration-behavior="{{ s.expiration_behavior }}"
      >
        {%- for key in unit_keys -%}
          {%- assign value = unit_values[forloop.index0] -%}
          {%- assign label = unit_labels[forloop.index0] | strip -%}
          {%- if forloop.index0 > 0 -%}
            <span class="countdown__separator" aria-hidden="true">:</span>
          {%- endif -%}
          <span class="countdown__item">
            {%- comment -%}
              Digits are aria-hidden: a timer that re-announces itself every second is
              unusable with a screen reader. The static aria-label above carries the date.
            {%- endcomment -%}
            <span class="countdown__digits" data-unit="{{ key }}" aria-hidden="true">
              {%- assign characters = value | split: '' -%}
              {%- for character in characters -%}
                <span class="countdown__digit" data-digit>{{ character }}</span>
              {%- endfor -%}
            </span>
            {%- if label != blank -%}
              <span class="countdown__unit" aria-hidden="true">{{ label }}</span>
            {%- endif -%}
          </span>
        {%- endfor -%}
      </countdown-timer>
    {%- endif -%}
  </div>
</slideshow-slide>

{% stylesheet %}
  .countdown {
    --countdown-ease: cubic-bezier(0.22, 0.61, 0.36, 1);

    display: block;
    width: 100%;
    color: var(--color, inherit);
  }

  /* The bar caps slides at 680px, which is too narrow for message + link + timer. */
  .announcement-bar__slides:has(.countdown) {
    width: 100%;
    max-width: none;
  }

  .countdown__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px clamp(12px, 3vw, 30px);
    min-height: 42px;
    text-align: center;
  }

  .countdown__text {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 22px);
    flex-wrap: wrap;
    justify-content: center;
  }

  .countdown__message {
    margin: 0;
    font-family: var(--countdown-font, var(--font-subheading--family));
    font-size: var(--countdown-size, 0.75rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
  }

  .countdown__link {
    font-family: var(--countdown-font, var(--font-subheading--family));
    font-size: var(--countdown-size, 0.75rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
    color: inherit;
    text-decoration: none;
    border-block-end: 1px solid rgb(var(--color-rgb, var(--color-foreground-rgb)) / 0.4);
    padding-block-end: 2px;
    transition: border-color 0.35s var(--countdown-ease);
  }

  .countdown__link:hover {
    /* currentColor, not --color-accent: the bar sits on the dark surface, where an ink
       accent underline would be invisible. This tracks whatever text color the bar uses. */
    border-color: currentColor;
  }

  .countdown__timer {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--countdown-timer-color, inherit);
  }

  .countdown__item {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
  }

  .countdown__digits {
    font-family: var(--font-accent--family);
    font-size: 0.8125rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    line-height: 1;
    /* Reserve the width so the row never reflows as digits change. */
    display: inline-flex;
  }

  .countdown__digit {
    display: inline-block;
    min-width: 0.62em;
    text-align: center;
    backface-visibility: hidden;
  }

  .countdown__digit.is-flipping {
    animation: countdown-flip 0.38s var(--countdown-ease) both;
  }

  @keyframes countdown-flip {
    0% {
      transform: rotateX(0deg);
      opacity: 1;
    }

    50% {
      transform: rotateX(-90deg);
      opacity: 0.35;
    }

    100% {
      transform: rotateX(0deg);
      opacity: 1;
    }
  }

  .countdown__unit {
    font-family: var(--font-accent--family);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
    opacity: 0.6;
  }

  .countdown__separator {
    font-family: var(--font-accent--family);
    font-size: 0.8125rem;
    line-height: 1;
    opacity: 0.45;
  }

  @media screen and (max-width: 749px) {
    .countdown__link {
      display: none;
    }

    .countdown__inner {
      gap: 8px 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .countdown__digit.is-flipping {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Countdown",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Message",
      "default": "Summer Sale — up to 40% off"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop now"
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "paragraph",
      "content": "The date is read in your store's timezone. Leave the date empty to show the message without a timer."
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date (YYYY-MM-DD)",
      "info": "For example 2026-11-25"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "End time (HH:MM, 24-hour)",
      "default": "00:00"
    },
    {
      "type": "select",
      "id": "expiration_behavior",
      "label": "When it reaches zero",
      "options": [
        {
          "value": "leave",
          "label": "Keep showing zeros"
        },
        {
          "value": "hide",
          "label": "Hide the bar"
        }
      ],
      "default": "leave"
    },
    {
      "type": "text",
      "id": "unit_labels",
      "label": "Unit labels",
      "default": "Days,Hrs,Min,Sec",
      "info": "Four comma-separated labels: days, hours, minutes, seconds."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font",
      "label": "Font",
      "options": [
        {
          "value": "var(--font-body--family)",
          "label": "Body"
        },
        {
          "value": "var(--font-subheading--family)",
          "label": "Subheading"
        },
        {
          "value": "var(--font-heading--family)",
          "label": "Heading"
        },
        {
          "value": "var(--font-accent--family)",
          "label": "Accent"
        }
      ],
      "default": "var(--font-subheading--family)"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "Size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "timer_color",
      "label": "Timer color",
      "placeholder": "Default"
    }
  ],
  "presets": [
    {
      "name": "Countdown"
    }
  ]
}
{% endschema %}
